{
  "buildCommand": "next build",
  "installCommand": "npm install",
  "devCommand": "next dev",
  "framework": "nextjs",
  "env": {
    "NEXT_PUBLIC_API_BASE_URL": "@next-public-api-base-url"
  },
  "regions": ["iad1"],
  "functions": {
    "src/app/api/**": {
      "memory": 1024,
      "maxDuration": 30
    }
  }
}
